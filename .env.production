# Production defaults that are NOT secrets — committed on purpose.
#
# Next.js loads this file for `next build` and for the production server, so
# these values apply on Vercel without anyone opening the project settings
# (the web and admin projects live in two different Vercel accounts). A value
# set in the Vercel dashboard still wins: Next never overwrites a variable that
# is already present in the environment.
#
# NEVER put a secret here (API keys, Stripe keys, session secrets, tokens).
# Those stay in the Vercel project settings / .env.local, which is gitignored.

# Vehicles feature (pickltmobile/.agent/plans/vehicles/0.master.md §4): the
# table ids are slugs, identical in every environment of this project.
APPWRITE_COLLECTION_VEHICLES=vehicles
APPWRITE_COLLECTION_VEHICLE_EVENTS=vehicle_events

# The zone a rental driver's "service day" is computed in. Every gate — cloud
# functions, web routes, the admin approval — must agree on it.
PLATFORM_TZ=Europe/Berlin

# Google Identity Services client id (the same Web OAuth client the mobile apps use as token audience;
# must list this site under "Authorized JavaScript origins" and be in googleauth GOOGLE_CLIENT_ID)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=653818424886-bknt6er79lfujhg7fi0jcbavkir4ltqn.apps.googleusercontent.com
NEXT_PUBLIC_FUNCTION_GOOGLEAUTH=googleauth
